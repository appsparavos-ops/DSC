# Backend — copiar a .env (NUNCA commitear .env)
# Clave de datos AES-256-GCM: 32 bytes en hex (generar: openssl rand -hex 32)
DATA_KEY=
# JSON de la clave de servicio de Firebase (secreto de Render; NO rellenar en git)
FIREBASE_SA_JSON=
# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8000,https://appsparavos-ops.github.io
# Puerto del servidor
PORT=10000
